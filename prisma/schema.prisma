generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum Theme {
  LIGHT
  DARK
  DEFAULT
}

model SiteSettings {
  id                    Int     @id @default(1)
  defaultSeoTitle       String? @db.VarChar(60)
  defaultSeoDescription String? @db.VarChar(160)
  titleSuffix           String  @default("| Alcotrade") @db.VarChar(30)

  ogImageUrl String?
  updatedAt  DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  theme         Theme     @default(DEFAULT)

  avatarPublicId String?

  passwordHash String?
  role         Role    @default(MANAGER)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// PRODUCT
enum ProductStatus {
  DRAFT
  ARCHIVE
  ACTIVE
}

model MediaAsset {
  id       String  @id @default(cuid())
  url      String
  alt      String?
  width    Int?
  height   Int?
  mimeType String?
  blurHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ProductImage ProductImage[]

  Product Product[]

  Brand         Brand[]
  variantImages ProductVariant[] @relation("VariantImage")

  Partner        Partner[]        @relation(name: "PartnerLogo")
  ProductVariant ProductVariant[]

  ArticleImage ArticleImage[]
  Article      Article[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict) // ⬅️ RESTRICT

  coverId String?
  cover   MediaAsset?    @relation(fields: [coverId], references: [id], onDelete: SetNull) // ⬅️ SET NULL
  images  ProductImage[]

  variants ProductVariant[]
  translations ProductTranslation[]

  seoTitle       String? @db.VarChar(60)
  seoDescription String? @db.VarChar(160)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([status])
  @@index([brandId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label    String?
  volumeMl Int?
  position Int     @default(0)

  imageId String?
  image   MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  MediaAsset MediaAsset[] @relation("VariantImage")
  translations ProductVariantTranslation[]

  @@index([productId])
}

model ProductImage {
  productId String
  mediaId   String
  position  Int    @default(0)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([position])
}

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVE
}

model Brand {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  status      BrandStatus @default(DRAFT)

  seoTitle       String? @db.VarChar(60)
  seoDescription String? @db.VarChar(160)

  coverId String?
  cover   MediaAsset? @relation(fields: [coverId], references: [id], onDelete: SetNull) // ⬅️ SET NULL

  products Product[]
  translations BrandTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model BrandTranslation {
  id            String            @id @default(cuid())
  brandId       String
  brand         Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale        TranslationLocale @default(en)
  name          String            @db.VarChar(200)
  slug          String?           @db.VarChar(200)
  description   String?           @db.Text
  seoTitle       String?          @db.VarChar(60)
  seoDescription String?          @db.VarChar(160)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([brandId, locale])
  @@index([locale])
  @@unique([slug, locale])
}

model Partner {
  id          String  @id @default(cuid())
  name        String
  description String?
  link        String? @unique

  logoId String?     @unique
  logo   MediaAsset? @relation(name: "PartnerLogo", fields: [logoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// NEW
enum NewsStatus {
  DRAFT
  ACTIVE
  ARCHIVE
}

model Article {
  id String @id @default(cuid())

  title   String
  excerpt String?    @db.VarChar(300) // короткий опис під превʼю (опц.)
  content String?    @db.Text // детальний опис/контент
  date    DateTime? // поле "Дата" у формі (для показу/сорту)
  status  NewsStatus @default(DRAFT)

  slug   String  @unique

  seoTitle       String? @db.VarChar(60)
  seoDescription String? @db.VarChar(160)

  coverId String?
  cover   MediaAsset?    @relation(fields: [coverId], references: [id], onDelete: SetNull)
  images  ArticleImage[]
  translations ArticleTranslation[]

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([date])
  @@index([publishedAt])
}

model ArticleImage {
  articleId String
  mediaId   String
  position  Int    @default(0)

  article Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
  @@index([position])
}

model ArticleTranslation {
  id             String            @id @default(cuid())
  articleId      String
  article        Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale         TranslationLocale @default(en)
  title          String            @db.VarChar(200)
  slug           String?           @db.VarChar(200)
  excerpt        String?           @db.VarChar(300)
  content        String?           @db.Text
  seoTitle       String?           @db.VarChar(60)
  seoDescription String?           @db.VarChar(160)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([articleId, locale])
  @@unique([slug, locale])
  @@index([locale])
}

// === Translations ===
// Generic locale-based translation models for products and variants.
// Keep extensible for future locales (currently we'll use 'en').

enum TranslationLocale {
  uk
  en
}

model ProductTranslation {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      TranslationLocale @default(en)
  name        String            @db.VarChar(200)
  slug        String?           @db.VarChar(200)
  description String?           @db.Text
  seoTitle       String?        @db.VarChar(60)
  seoDescription String?        @db.VarChar(160)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([productId, locale])
  @@index([locale])
  @@unique([slug, locale])
}

model ProductVariantTranslation {
  id         String            @id @default(cuid())
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locale     TranslationLocale @default(en)
  label      String?           @db.VarChar(120)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([variantId, locale])
  @@index([locale])
}

// === Main Page Section Translations ===
// Stores translatable content for all sections of the main page.
// Each section has a unique key identifier.

model MainPageSection {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "hero", "about", "brands", "capabilities", "partners"
  position    Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MainPageSectionItem[]
}

model MainPageSectionItem {
  id          String   @id @default(cuid())
  sectionId   String
  section     MainPageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key         String   // e.g. "title", "description", "buttonText", "item1Title", etc.
  valueUk     String   @db.Text
  valueEn     String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sectionId, key])
  @@index([sectionId])
}
